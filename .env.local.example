# Copia questo file in .env.local e compila (MAI committare .env.local / .env).
# In produzione le stesse variabili vanno su Vercel:
# Project → Settings → Environment Variables (ambiente: Production).

# ── Generazione AI (obbligatoria) ─────────────────────────────────────
# Chiave API Anthropic: https://platform.claude.com → API Keys → Create Key.
# Usata per 5 chiamate/giorno (4 voci + editor) con claude-sonnet-5.
ANTHROPIC_API_KEY=

# ── Salvataggio su GitHub (obbligatorio in produzione) ────────────────
# Su Vercel il filesystem è read-only: il giorno generato viene COMMITTATO
# nel repo bifulcma/gospel-dono via API → il push triggera il redeploy.
# Serve un fine-grained PAT: GitHub → Settings → Developer settings →
# Personal access tokens → Fine-grained tokens → Generate new token:
#   - Repository access: Only select repositories → bifulcma/gospel-dono
#   - Permissions → Repository permissions → Contents: Read and write
#   - Scadenza: massima disponibile (poi va rinnovato)
# In locale può restare vuoto: il file viene scritto su disco.
GITHUB_TOKEN=

# ── Protezione del cron (consigliata) ─────────────────────────────────
# Se impostato, /api/daily accetta solo richieste con header
# "Authorization: Bearer <CRON_SECRET>". Il cron Vercel lo manda da solo
# quando la variabile esiste nel progetto. Genera un valore lungo e casuale.
CRON_SECRET=

# ── Lezionario (opzionale) ────────────────────────────────────────────
# Metti a 1 per saltare le API del lezionario (letture da inserire a mano).
LEZIONARIO_MANUALE=0
