# Copia in .env.local e compila (MAI committare .env.local)

# Protegge /api/daily: se impostato, il cron Vercel manda "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Metti a 1 per saltare le API del lezionario e inserire le letture a mano nei file content/
LEZIONARIO_MANUALE=0

# Per la futura generazione AI dei commenti (vedi README, sezione "Collegare la generazione AI")
ANTHROPIC_API_KEY=
